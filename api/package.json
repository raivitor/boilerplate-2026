{
  "name": "boilerplate-api",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal Express + Drizzle boilerplate API with a sample CRUD and healthcheck.",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": "24.x",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/server.js",
    "test": "npm run test:unit",
    "test:unit": "NODE_ENV=test node --env-file-if-exists=.env --import tsx --test --test-reporter spec --test-concurrency=1 \"src/**/*.unit.spec.ts\"",
    "test:integration": "NODE_ENV=test node --env-file-if-exists=.env --import tsx src/scripts/test-integration.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "NODE_ENV=test node --env-file-if-exists=.env --import tsx --test --watch \"src/**/*.unit.spec.ts\"",
    "test:coverage": "NODE_ENV=test node --env-file-if-exists=.env --import tsx src/scripts/test-integration.ts --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node --env-file-if-exists=.env --import tsx src/scripts/reset-db.ts",
    "format:check": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "supertest": "^7.3.1"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
